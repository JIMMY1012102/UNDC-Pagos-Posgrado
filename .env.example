APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Cambiar a America/Lima requiere confirmar antes cómo están guardadas las fechas en producción.
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Producción: considerar SESSION_DRIVER=redis con Redis configurado.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# Producción: considerar QUEUE_CONNECTION=redis con Redis y un worker activo.
QUEUE_CONNECTION=database

# Producción: considerar CACHE_STORE=redis con Redis configurado.
CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Acceso Google: apagado hasta credenciales y HTTPS aprobados por OTI
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gemini: clave privada en el entorno del proceso Python; nunca versionarla.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_FALLBACK_MODEL=

# Agente FastAPI/MCP. Generar un token aleatorio largo y compartirlo solo entre procesos.
ASSISTANT_AGENT_URL=http://127.0.0.1:8091
ASSISTANT_AGENT_TOKEN=
LARAVEL_INTERNAL_BASE_URL=http://127.0.0.1:8000
ASSISTANT_MAX_TOOL_ROUNDS=5

# Activar solo tras implementar y validar la integración de cobro.
PAYME_ENABLED=false
